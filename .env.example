# Copy to .env.local and fill in. Everything is optional for local development:
# without DATABASE_URL the app uses an embedded PGlite database in .data/pglite,
# and without S3_* uploads are stored in .data/uploads.

# Neon Postgres connection string (run `pnpm db:migrate` after setting it)
DATABASE_URL=

# Better Auth: a long random string (e.g. `openssl rand -base64 32`) and the site URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails that are always admins
ADMIN_EMAILS=

# Cloudflare R2 (S3-compatible) for uploaded photos
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET=
# Public base URL of the bucket (r2.dev subdomain or custom domain)
S3_PUBLIC_URL=

# Canonical site URL used for Open Graph links (defaults to siteUrl in src/data/brand.json)
NEXT_PUBLIC_SITE_URL=https://lovecard-next.netlify.app
